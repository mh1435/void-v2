<svg xmlns="http://www.w3.org/2000/svg" width="280" height="360" viewBox="0 0 280 360">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#0a0a12"/>
      <stop offset="100%" stop-color="#111120"/>
    </linearGradient>
    <linearGradient id="glow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#e67e22" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#e67e22" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <!-- background -->
  <rect width="280" height="360" fill="url(#bg)"/>
  <!-- hex grid pattern lines -->
  <line x1="0" y1="60" x2="280" y2="60" stroke="#e67e22" stroke-width="0.4" stroke-opacity="0.15"/>
  <line x1="0" y1="120" x2="280" y2="120" stroke="#e67e22" stroke-width="0.4" stroke-opacity="0.15"/>
  <line x1="0" y1="180" x2="280" y2="180" stroke="#e67e22" stroke-width="0.4" stroke-opacity="0.15"/>
  <line x1="0" y1="240" x2="280" y2="240" stroke="#e67e22" stroke-width="0.4" stroke-opacity="0.15"/>
  <line x1="0" y1="300" x2="280" y2="300" stroke="#e67e22" stroke-width="0.4" stroke-opacity="0.15"/>
  <line x1="60" y1="0" x2="60" y2="360" stroke="#e67e22" stroke-width="0.4" stroke-opacity="0.15"/>
  <line x1="140" y1="0" x2="140" y2="360" stroke="#e67e22" stroke-width="0.4" stroke-opacity="0.15"/>
  <line x1="220" y1="0" x2="220" y2="360" stroke="#e67e22" stroke-width="0.4" stroke-opacity="0.15"/>
  <!-- glow overlay -->
  <rect width="280" height="360" fill="url(#glow)"/>
  <!-- corner accent lines -->
  <line x1="0" y1="0" x2="40" y2="0" stroke="#e67e22" stroke-width="2"/>
  <line x1="0" y1="0" x2="0" y2="40" stroke="#e67e22" stroke-width="2"/>
  <line x1="280" y1="0" x2="240" y2="0" stroke="#e67e22" stroke-width="2"/>
  <line x1="280" y1="0" x2="280" y2="40" stroke="#e67e22" stroke-width="2"/>
  <line x1="0" y1="360" x2="40" y2="360" stroke="#e67e22" stroke-width="2"/>
  <line x1="0" y1="360" x2="0" y2="320" stroke="#e67e22" stroke-width="2"/>
  <line x1="280" y1="360" x2="240" y2="360" stroke="#e67e22" stroke-width="2"/>
  <line x1="280" y1="360" x2="280" y2="320" stroke="#e67e22" stroke-width="2"/>
  <!-- initial circle -->
  <circle cx="140" cy="155" r="72" fill="none" stroke="#e67e22" stroke-width="1.5" stroke-opacity="0.4"/>
  <circle cx="140" cy="155" r="60" fill="#e67e22" fill-opacity="0.12"/>
  <text x="140" y="175" font-family="'Arial Black', Arial, sans-serif" font-size="72" font-weight="900" fill="#e67e22" text-anchor="middle" fill-opacity="0.85">K</text>
  <!-- hero name -->
  <text x="140" y="262" font-family="'Arial Black', Arial, sans-serif" font-size="22" font-weight="900" fill="#e8e8f0" text-anchor="middle" letter-spacing="4">KHALEED</text>
  <!-- role label -->
  <text x="140" y="290" font-family="Arial, sans-serif" font-size="11" fill="#e67e22" text-anchor="middle" letter-spacing="2" fill-opacity="0.85">FIGHTER</text>
  <!-- bottom scan line -->
  <rect x="30" y="310" width="220" height="1" fill="#e67e22" fill-opacity="0.5"/>
  <text x="140" y="335" font-family="monospace" font-size="9" fill="#e67e22" text-anchor="middle" fill-opacity="0.5" letter-spacing="1">VOID // UNIT DATABASE</text>
</svg>